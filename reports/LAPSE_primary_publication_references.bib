@article{ray2021,
  title = {The Biodiversity Crisis in {{Canada}}: {{Failures}} and Challenges of Federal and Sub-National Strategic and Legal Frameworks},
  shorttitle = {The Biodiversity Crisis in {{Canada}}},
  author = {Ray, Justina C. and Grimm, Jaime and Olive, Andrea},
  editor = {Beazley, Karen},
  date = {2021-01-01},
  journaltitle = {FACETS},
  shortjournal = {FACETS},
  volume = {6},
